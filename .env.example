# Path to the SQLite database file. Created automatically if missing.
DATABASE_URL=./data/kennook.db

# Where thumbnails are written.
THUMBNAILS_DIR=./data/thumbnails

# Path to the Transformers.js model cache.
# Models are downloaded on first run (~250MB for CLIP base).
TRANSFORMERS_CACHE=./data/models

# YouTube Data API v3 key — enables external YouTube sources (channels/playlists).
# Create one in Google Cloud Console (enable 'YouTube Data API v3'), key-only, no OAuth.
YOUTUBE_API_KEY=

# ── Optional external-source tokens (single app-level token; NO per-user OAuth) ──
# Direct/HLS streams, RSS/podcasts, Internet Archive, single Vimeo videos, and
# Twitch channels/VODs all work with NO token. These only unlock extras:
#   VIMEO_ACCESS_TOKEN     — Vimeo channels/showcases (single videos need nothing).
#   TWITCH_CLIENT_ID/SECRET — nicer Twitch channel names/thumbnails (playback works
#                             without them). Create an app at dev.twitch.tv.
VIMEO_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
