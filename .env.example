# Path to the SQLite database file. Created automatically if missing.
DATABASE_URL=./data/kennook.db

# Where thumbnails are written.
THUMBNAILS_DIR=./data/thumbnails

# Path to the Transformers.js model cache.
# Models are downloaded on first run (~250MB for CLIP base).
TRANSFORMERS_CACHE=./data/models

# YouTube Data API v3 key — enables external YouTube sources (channels/playlists).
# Create one in Google Cloud Console (enable 'YouTube Data API v3'), key-only, no OAuth.
YOUTUBE_API_KEY=
